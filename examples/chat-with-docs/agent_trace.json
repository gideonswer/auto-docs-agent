{
  "notes": {
    "purpose": "A lightweight RAG (Retrieval\u2011Augmented Generation) web service that lets users upload PDFs, ask questions, and receive answers with page\u2011level citations. It supports user accounts, isolated workspaces, and built\u2011in evaluation of answer quality.",
    "features": [
      "Upload and manage PDF documents per workspace",
      "Chat interface that returns answers with citations",
      "JWT\u2011based authentication and per\u2011user workspaces",
      "Automatic chunking of PDFs with overlap for better retrieval",
      "Vector store backed by ChromaDB, filtered by workspace",
      "LLM abstraction that supports Gemini, Groq, Claude, or any OpenAI\u2011compatible provider",
      "Evaluation pipeline that compares LLM answers to reference answers and reports metrics",
      "Health endpoint exposing LLM configuration",
      "Static front\u2011end served from /static"
    ],
    "how_it_works": [
      "User registers/logs in, receiving a JWT token",
      "User creates a workspace and uploads PDFs",
      "PDF is parsed into pages, cleaned, split into overlapping chunks, and each chunk is embedded via sentence\u2011transformers",
      "Chunks are stored in ChromaDB tagged with the workspace ID",
      "When a question is posted, the system embeds the query, retrieves top\u2011k relevant chunks, builds a prompt with citations, and calls the configured LLM",
      "The LLM response is returned with citation markers and the source passages can be viewed",
      "Evaluation runs use the same pipeline but compare the LLM answer to a reference answer and compute metrics"
    ],
    "components": [
      {
        "name": "app.main",
        "paths": [
          "app/main.py"
        ],
        "responsibility": "FastAPI app setup, router inclusion, health endpoint, static file serving"
      },
      {
        "name": "app.config",
        "paths": [
          "app/config.py"
        ],
        "responsibility": "Central settings holder using pydantic\u2011settings"
      },
      {
        "name": "app.db",
        "paths": [
          "app/db.py"
        ],
        "responsibility": "SQLAlchemy engine and session factory"
      },
      {
        "name": "app.models",
        "paths": [
          "app/models.py"
        ],
        "responsibility": "ORM models for users, workspaces, documents, eval runs, and chunks"
      },
      {
        "name": "app.embeddings",
        "paths": [
          "app/embeddings.py"
        ],
        "responsibility": "Sentence\u2011transformer based embedder"
      },
      {
        "name": "app.vectorstore",
        "paths": [
          "app/vectorstore.py"
        ],
        "responsibility": "ChromaDB wrapper for storing and querying chunks"
      },
      {
        "name": "app.rag",
        "paths": [
          "app/rag.py"
        ],
        "responsibility": "Prompt construction, citation parsing, and answer generation"
      },
      {
        "name": "app.llm",
        "paths": [
          "app/llm.py"
        ],
        "responsibility": "Provider\u2011agnostic LLM interface and fallback logic"
      },
      {
        "name": "app.ingest",
        "paths": [
          "app/ingest.py"
        ],
        "responsibility": "PDF parsing, page extraction, cleaning, chunking"
      },
      {
        "name": "app.evals",
        "paths": [
          "app/evals.py"
        ],
        "responsibility": "Evaluation logic: scoring, judging, summarizing results"
      }
    ],
    "external_services": [
      "ChromaDB (local file store)",
      "OpenAI API (for Gemini, Groq, Ollama, or any OpenAI\u2011compatible endpoint)",
      "Anthropic API (if Claude provider is selected)"
    ],
    "setup_steps": [
      "Create a virtual environment and install requirements from requirements.txt",
      "Copy .env.example to .env and set required environment variables (JWT_SECRET, LLM keys, etc.)",
      "Run the app with `uvicorn app.main:app --reload`"
    ],
    "run_commands": [
      "uvicorn app.main:app --reload"
    ],
    "usage_examples": [
      "Register: `POST /api/auth/register` with JSON body `{\"email\":\"user@example.com\",\"password\":\"secret\"}`",
      "Login: `POST /api/auth/login` with form data `username=user@example.com&password=secret` \u2192 returns JWT token",
      "Create workspace: `POST /api/workspaces` with JSON `{\"name\":\"My Docs\"}`",
      "Upload PDF: `POST /api/workspaces/{id}/documents` with multipart file",
      "Chat: `POST /api/workspaces/{id}/chat` with JSON `{\"question\":\"What is X?\"}`",
      "Evaluation: `POST /api/workspaces/{id}/evals` with JSON `{\"cases\":[{...}]}`"
    ],
    "gotchas": [
      "The default JWT_SECRET is a placeholder; use a secure random string before deployment",
      "LLM providers require API keys; the fallback provider is used only if the primary fails",
      "ChromaDB stores data in ./data/chroma; ensure write permissions",
      "PDF ingestion can be slow for large files; chunk size and overlap are tunable via env vars",
      "Evaluation tests run offline using fake embedder/LLM; real runs will incur API usage"
    ]
  },
