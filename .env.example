# Copy this file to .env and fill in your keys. NEVER commit .env to GitHub.

# Main model: Gemini free tier (get a key at https://aistudio.google.com/apikey)
LLM_PROVIDER=gemini
LLM_MODEL=gemini-3.8-flash
GEMINI_API_KEY=

# Backup model: Groq free tier, used automatically if Gemini fails (key at https://console.groq.com/keys)
# Leave LLM_FALLBACK_PROVIDER blank to turn the backup off.
LLM_FALLBACK_PROVIDER=groq
LLM_FALLBACK_MODEL=openai/gpt-oss-20b
GROQ_API_KEY=

# How long thinking models think: none, low, medium or high. Blank = the model's default.
REASONING_EFFORT=low

# Max agent tool calls per repo. More = better docs, but more API calls.
MAX_AGENT_STEPS=8

# Optional: lets you document private repos and raises GitHub's download limits
GITHUB_TOKEN=

# Switch to Claude: set the provider and model lines above to
#   LLM_PROVIDER=claude
#   LLM_MODEL=claude-haiku-5-5
# and add your key here (also run: pip install anthropic)
ANTHROPIC_API_KEY=

# Run fully offline with Ollama: LLM_PROVIDER=openai_compatible, LLM_MODEL=llama3.2
OPENAI_COMPATIBLE_BASE_URL=http://localhost:11434/v1
